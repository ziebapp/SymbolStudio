{
  "name": "video-production",
  "version": "1.0.0",
  "description": "Reusable AI video production project (Remotion + Higgsfield + FFmpeg)",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.533",
    "@remotion/media": "4.0.533",
    "@remotion/shapes": "4.0.533",
    "@remotion/transitions": "4.0.533",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.533",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "studio": "remotion studio",
    "dev": "remotion studio",
    "render:preview": "remotion render MainFilm exports/preview/MainFilm-preview.mp4 --scale=0.5 --crf=28 --jpeg-quality=70",
    "render:final": "remotion render MainFilm exports/final/MainFilm.mp4 --codec=h264 --crf=16 --audio-codec=aac --audio-bitrate=320k",
    "render:vertical": "remotion render MainFilmVertical exports/final/MainFilmVertical.mp4 --codec=h264 --crf=16 --audio-codec=aac --audio-bitrate=320k",
    "render:vertical-preview": "remotion render MainFilmVertical exports/preview/MainFilmVertical-preview.mp4 --scale=0.5 --crf=28 --jpeg-quality=70",
    "render:still": "remotion still MainFilm exports/stills/MainFilm.png",
    "render:test": "npm run test:media && remotion render ComponentTest temp/ComponentTest.mp4",
    "test:media": "bash scripts/make-test-media.sh",
    "next-version": "node scripts/next-version.mjs",
    "verify": "bash scripts/verify-tools.sh",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src compositions && tsc"
  }
}
